# =============================================================
# BitLink — Environment Variable Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is listed in .gitignore.
#
#   cp .env.example .env
#   nano .env
# =============================================================


# -------------------------------------------------------
# Database
# -------------------------------------------------------
# DB_PASSWORD is used by docker-compose.yml to build
# DATABASE_URL automatically — keep both values in sync.
DB_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://bitlink:replace_with_strong_password@db:5432/bitlink
DB_POOL_MAX=30
DB_POOL_TIMEOUT=10


# -------------------------------------------------------
# Slack App 1 — WhatsApp bridge
# -------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me


# -------------------------------------------------------
# Slack App 2 — Telegram bridge
# -------------------------------------------------------
SLACK_BOT_TOKEN_TELEGRAM=xoxb-replace-me
SLACK_APP_TOKEN_TELEGRAM=xapp-replace-me


# -------------------------------------------------------
# Slack App 3 — Manager (slash commands & modals)
# -------------------------------------------------------
MANAGER_SLACK_BOT_TOKEN=xoxb-replace-me
MANAGER_SLACK_APP_TOKEN=xapp-replace-me


# -------------------------------------------------------
# Slack channel/user IDs
# -------------------------------------------------------
# The Slack user ID (starts with U) of the master bot account.
# Find it in Slack: click your profile → ID at the bottom.
MASTER_SLACK_BOT_ID=U0REPLACE

# The channel that receives kill-switch alerts.
SLACK_ADMIN_CHANNEL_ID=C0REPLACE


# -------------------------------------------------------
# Telegram
# -------------------------------------------------------
API_ID=replace_me
API_HASH=replace_me


# -------------------------------------------------------
# AI — Google Gemini
# -------------------------------------------------------
GEMINI_API_KEY=replace_me


# -------------------------------------------------------
# Internal service URLs & ports
# These must use Docker service hostnames (not 127.0.0.1).
# -------------------------------------------------------
NODE_API_URL=http://gateway:3101
WHATSAPP_REFRESH_PORT=8101
TELEGRAM_REFRESH_PORT=8003
DISCORD_REFRESH_PORT=8102
CONTROL_DASHBOARD_PORT=5050
SESSIONS_DIR=sessions
MAX_FILE_SIZE_MB=50


# -------------------------------------------------------
# Delivery handover fallback
# Used only when the project_managers table is empty.
# -------------------------------------------------------
PROJECT_MANAGER_SLACK_ID=U0REPLACE


# -------------------------------------------------------
# Optional — Upwork mail bridge (main_upwork.py)
# Leave blank if you do not use Upwork.
# -------------------------------------------------------
# UPWORK_EMAIL_ADDRESS=
# UPWORK_EMAIL_PASSWORD=
# UPWORK_IMAP_SERVER=imap.gmail.com
# UPWORK_SMTP_SERVER=smtp.gmail.com
# UPWORK_POLL_INTERVAL=60
